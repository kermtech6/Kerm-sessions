{
    "name": "KERM-MD-V1",
    "description": "Web Session Generator",
    "logo": "https://github.com/Mayelprince.png",
    "repository": "https://github.com/kermtech6/KERM-MD-V1",
    "keywords": [
        "kerm-Tech"
    ],
    "success_url": "/",
    "buildpacks": [
        {
            "url": "heroku/nodejs"
        }
    ],
    "env": {
        "MAX_SESSIONS": {
            "description": "Nombre max de sessions générées en même temps (10 pour un dyno 512 Mo)",
            "value": "10",
            "required": false
        },
        "MEGA_EMAIL": {
            "description": "Compte MEGA qui stocke les sessions (optionnel)",
            "required": false
        },
        "MEGA_PASSWORD": {
            "description": "Mot de passe du compte MEGA (optionnel)",
            "required": false
        }
    }
}
